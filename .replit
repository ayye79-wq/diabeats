entrypoint = "README.md"
modules = ["nodejs-22", "python-base-3.13", "postgresql-16", "java-graalvm22.3"]

[nix]
channel = "stable-24_05"
# React Native DevTools bundles an Electron desktop binary. Keep this Linux
# runtime package contract in sync with its shared-library requirements; the
# check:expo-devtools command verifies the list before starting Expo.
packages = ["glib", "nss", "dbus", "atk", "at-spi2-atk", "cups", "cairo", "gtk3", "pango", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "mesa", "xorg.libxcb", "libxkbcommon", "alsa-lib", "at-spi2-core", "nspr", "libdrm", "expat", "systemd"]

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8099
externalPort = 8099
exposeLocalhost = true


[agent]
stack = "EXPO"
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run expo:dev"
waitForPort = 8081

[userenv]

[userenv.shared]
EXPO_PUBLIC_RC_IOS_KEY = "appl_uSpLBmaIfBYmyUVOAMiXGxNGbhN"
EXPO_PUBLIC_RC_ANDROID_KEY = "goog_qoJzLFRswmgzdBWYCTqBYtrdQLF"
TIKTOK_REDIRECT_URI = "https://diabeatsapp.com/api/tiktok/callback"
REVENUECAT_PROJECT_ID = "proj6649d894"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 900000
