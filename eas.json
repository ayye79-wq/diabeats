{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "android-analytics-test": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_NATIVE_ANALYTICS_ENABLED": "true"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "diabeatsapp.com"
      },
      "ios": {
        "autoIncrement": false
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    },
    "testflight-analytics": {
      "extends": "production",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_NATIVE_ANALYTICS_ENABLED": "true"
      },
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6760898764",
        "appleTeamId": "RGU32A7465"
      }
    }
  }
}
